# Copy to .env. Never commit .env.

# Hedera JSON-RPC relay. Testnet by default.
HEDERA_RPC_URL=https://testnet.hashio.io/api

# Deployer key for Hedera testnet, one of the two forms below.
# Either a plain ECDSA private key (0x-prefixed hex) for scripted use ...
DEPLOYER_PRIVATE_KEY=
# ... or the encrypted form written by `yarn hardhat:account:generate` or `yarn hardhat:account:import`.
DEPLOYER_PRIVATE_KEY_ENCRYPTED=

# Hedera account that owns the HCS topic and submits records. Used by the deploy script that creates
# the topic and by scripts/record-sync. The same key as the deployer works once the account exists.
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
