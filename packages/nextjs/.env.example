# Copy to .env.local. Never commit it. The app boots and every page renders with none of these set.

# WalletConnect project id for wallet connections. Optional.
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=

# JSON-RPC relay overrides. Optional; the public hashio relays are the default.
NEXT_PUBLIC_HEDERA_TESTNET_RPC_URL=
NEXT_PUBLIC_HEDERA_MAINNET_RPC_URL=

# Mirror node override. Optional; the public mirror node for the target network is the default.
NEXT_PUBLIC_MIRROR_NODE_URL=

# Server-side only. Lets /api/record submit market terms and settlements to the HCS topic.
# Without them the route answers 503 and the rest of the app works.
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
