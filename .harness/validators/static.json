{
  "name": "verdict-outside-kind-static",
  "description": "Static invariants for the Outside market kind: the enum value, the bounds check and payoff branch, the test helper mirror, the test table, the frontend lib, the question text, the API and record builders, the scripts and the README, with the repo's docs and layout intact.",
  "jsonAssertions": [
    {
      "file": "package.json",
      "path": "packageManager",
      "equals": "yarn@3.2.3"
    }
  ],
  "fileAssertions": {
    "required": [
      "README.md",
      "AGENTS.md",
      "LICENSE",
      "template.json",
      "docs/TUTORIAL.md",
      "packages/hardhat/contracts/interfaces/IVerdict.sol",
      "packages/hardhat/contracts/Verdict.sol",
      "packages/hardhat/test/Verdict.test.ts",
      "packages/nextjs/lib/payoff.ts",
      "packages/nextjs/components/PayoffDiagram.tsx",
      ".harness/spec.yaml",
      ".harness/prd.md",
      "packages/hardhat/test/helpers/verdict.ts",
      "packages/nextjs/lib/question.ts",
      "packages/nextjs/app/api/_lib/messages.ts",
      "packages/nextjs/app/llms.txt/route.ts",
      "packages/hardhat/scripts/lib/testnetMarket.ts",
      "packages/hardhat/scripts/record-sync.ts",
      "docs/img/payoff-outside.svg"
    ],
    "forbidden": [
      ".env",
      "packages/hardhat/.env",
      "packages/nextjs/.env",
      "packages/nextjs/.env.local"
    ]
  },
  "textAssertions": [
    {
      "file": "packages/hardhat/contracts/interfaces/IVerdict.sol",
      "contains": [
        "Outside"
      ]
    },
    {
      "file": "packages/hardhat/contracts/Verdict.sol",
      "contains": [
        "Outside"
      ]
    },
    {
      "file": "packages/hardhat/test/Verdict.test.ts",
      "contains": [
        "Outside"
      ]
    },
    {
      "file": "packages/nextjs/lib/payoff.ts",
      "contains": [
        "Outside"
      ]
    },
    {
      "file": "README.md",
      "contains": [
        "yarn hardhat:test",
        "Outside",
        "payoff-outside.svg"
      ]
    },
    {
      "file": "packages/hardhat/test/helpers/verdict.ts",
      "contains": [
        "Outside"
      ]
    },
    {
      "file": "packages/nextjs/lib/question.ts",
      "contains": [
        "Outside"
      ]
    },
    {
      "file": "packages/nextjs/app/api/_lib/messages.ts",
      "contains": [
        "Outside"
      ]
    },
    {
      "file": "packages/nextjs/app/llms.txt/route.ts",
      "contains": [
        "Outside"
      ]
    },
    {
      "file": "packages/hardhat/scripts/lib/testnetMarket.ts",
      "contains": [
        "Outside"
      ]
    },
    {
      "file": "packages/hardhat/scripts/record-sync.ts",
      "contains": [
        "Outside"
      ]
    }
  ]
}
